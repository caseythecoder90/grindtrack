@startuml
' Grindtrack data model (Postgres schema `grindtrack`). Render: see diagrams/render.sh
hide circle
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 13
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam ArrowColor #33475B
skinparam entity {
  BackgroundColor #EEF2F7
  BorderColor #33475B
  FontColor #12243A
}

entity "users" as users #E3F0FF {
  * id : bigint <<PK, identity>>
  --
  * username : text <<unique>>
  * password_hash : text
  * totp_secret : text
  created_at : timestamptz
}
entity "refresh_tokens" as refresh_tokens #E3F0FF {
  * id : bigint <<PK, identity>>
  --
  * user_id : bigint <<FK → users, ON DELETE CASCADE>>
  * token_hash : text <<unique, sha-256 hex>>
  * expires_at : timestamptz
  * revoked : boolean
}
entity "daily_logs" as daily_logs #EAF3EC {
  * log_date : date <<PK (natural key)>>
  --
  hours : numeric  (0–24 CHECK)
  categories : text  (comma-separated)
  focus / did / wins / blockers : text
  energy : int  (1–5 CHECK, nullable)
  updated_at : timestamptz
}
entity "weekly_reviews" as weekly_reviews #EAF3EC {
  * week_start : date <<PK (a Monday)>>
  --
  summary / wins / blockers : text
  adjustments / next_focus : text
  on_track : boolean (nullable)
  updated_at : timestamptz
}
entity "focus_sessions" as focus_sessions #EAF3EC {
  * id : bigint <<PK, identity>>
  --
  * session_date : date
  * started_at : timestamptz
  * duration_minutes : int (1–1440 CHECK)
  * completed : boolean
  created_at : timestamptz
}
entity "plan_items" as plan_items #FFF3D6 {
  * id : bigint <<PK, identity>>
  --
  item_type / title / status : text
  notes / details / target_label : text
  completed_at : timestamptz (set on → done)
  qtr / year_num / tier / sort_order : int
}
entity "plan_quarters" as plan_quarters #FFF3D6 {
  * qtr : int <<PK>>
  --
  window_label / primary_focus : text
  secondary_focus / career_track : text
}
entity "plan_reference" as plan_reference #FFF3D6 {
  * sheet : text <<PK>>
  --
  title : text
  content_json : text
  sort_order : int
}

entity "finance_accounts" as finance_accounts #D6ECFF {
  * id : bigint <<PK, identity>>
  --
  name / institution / account_type : text (CHECK)
  last4 : text (leading zeros are real)
  current_balance : numeric(12,2) (liabilities negative)
  balance_as_of : date
  counts_toward_savings / active : boolean
  sort_order : int
}
entity "finance_transactions" as finance_transactions #D6ECFF {
  * id : bigint <<PK, identity>>
  --
  * account_id : bigint <<FK, cascade>>
  * posted_date : date
  transaction_date : date
  * amount : numeric(12,2) (signed, − = out)
  raw_description : text (never edited)
  merchant : text (normalized)
  txn_type : SPEND/INCOME/TRANSFER/PAYMENT
  category / issuer_category : text
  category_source : UNCATEGORIZED/RULE/MANUAL
  pending : boolean
  * fingerprint : text <<UNIQUE per account>>
}
entity "finance_savings_goals" as finance_savings_goals #D6ECFF {
  * id : bigint <<PK, identity>>
  --
  name : text
  target_amount : numeric(12,2)
  target_date : date
  note : text (why this number)
  active : boolean
  sort_order : int
}

users ||--o{ refresh_tokens
finance_accounts ||--o{ finance_transactions
@enduml
